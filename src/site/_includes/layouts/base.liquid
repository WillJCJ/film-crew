<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title | default: "Film Crew" }}</title>
    <meta name="description" content="Our weekly film picks">
    <link rel="icon" type="image/svg+xml" href="/assets/brand/pork-pie.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-touch-icon.png">
    <link rel="stylesheet" href="/assets/site.css">
    <script defer src="/assets/app.js"></script>
    {% if pageScript %}
    <script defer src="{{ pageScript }}"></script>
    {% endif %}
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <div>
          <a class="brand" href="/">
            <img class="brand-mark" src="/assets/brand/pork-pie.svg" alt="">
            <span>Film Crew</span>
          </a>
          <p class="tagline">Weekly picks, scorecards, and a proper archive.</p>
        </div>
        <nav class="site-nav" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/stats/">Stats</a>
          <a href="/archive/">Archive</a>
          <a class="authed-only" href="/dashboard/">Dashboard</a>
          <a class="authed-only" href="/cdn-cgi/access/logout?redirect_url=%2Flogin%2F">Logout</a>
          <a class="unauthed-only" href="/login/">Login</a>
        </nav>
      </header>

      <main>
        {{ content }}
      </main>

      <footer class="site-footer">
        <p class="footer-memorial">
          RIP <a href="https://maps.app.goo.gl/gmMGENdTBNFjLAt78">Film Crew Pie</a> - Forever in our hearts<br>
          <b>28/8/26 - 11/3/26</b>
        </p>
        <a class="footer-github" href="https://github.com/WillJCJ/film-crew" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 0C5.37 0 0 5.37 0 12a12 12 0 0 0 8.21 11.39c.6.11.82-.26.82-.58v-2.02c-3.34.73-4.04-1.61-4.04-1.61a3.18 3.18 0 0 0-1.34-1.75c-1.1-.75.08-.74.08-.74a2.5 2.5 0 0 1 1.82 1.23 2.53 2.53 0 0 0 3.46.99 2.54 2.54 0 0 1 .76-1.59c-2.67-.3-5.47-1.33-5.47-5.94a4.65 4.65 0 0 1 1.24-3.23 4.31 4.31 0 0 1 .12-3.19s1.01-.32 3.31 1.23a11.45 11.45 0 0 1 6.03 0c2.3-1.55 3.31-1.23 3.31-1.23.44 1.01.49 2.13.13 3.19a4.65 4.65 0 0 1 1.24 3.23c0 4.62-2.81 5.64-5.49 5.93a2.85 2.85 0 0 1 .82 2.22v3.29c0 .32.21.69.83.58A12 12 0 0 0 24 12c0-6.63-5.37-12-12-12Z" />
          </svg>
          <span>View on GitHub</span>
        </a>
      </footer>
    </div>
  </body>
  </html>