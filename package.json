{
  "name": "film-crew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:site",
    "build:site": "eleventy --config=eleventy.config.js",
    "lint:css": "stylelint \"src/site/assets/**/*.css\"",
    "lint:html": "npm run build:site && htmlhint \"dist/**/*.html\"",
    "lint:js": "eslint \"src/**/*.js\" \"worker/tests/**/*.js\" eleventy.config.js",
    "lint:md": "markdownlint-cli2 README.md AGENTS.md",
    "lint": "npm run lint:css && npm run lint:html && npm run lint:js && npm run lint:md",
    "dev": "concurrently -k -n SITE,WORKER -c yellow,cyan \"npm:dev:site\" \"npm:dev:worker\"",
    "dev:site": "eleventy --config=eleventy.config.js --watch",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:pull:remote": "mkdir -p .tmp && wrangler d1 export film-crew --remote --output .tmp/remote-d1-export.sql --skip-confirmation",
    "db:pull:local": "rm -rf .wrangler/state/v3/d1 && wrangler d1 execute film-crew --local --file .tmp/remote-d1-export.sql --yes",
    "db:pull": "npm run db:pull:remote && npm run db:pull:local",
    "test": "node --test 'worker/tests/**/*.test.js'"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "htmlhint": "^1.9.2",
    "markdownlint-cli2": "^0.22.1",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "wrangler": "^4.15.0"
  },
  "dependencies": {
    "grammy": "^1.42.0",
    "hono": "^4.12.25"
  }
}
