{
  "name": "film-crew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:site",
    "build:site": "eleventy --config=eleventy.config.js",
    "lint:css": "stylelint \"src/site/assets/**/*.css\"",
    "dev": "concurrently -k -n SITE,WORKER -c yellow,cyan \"npm:dev:site\" \"npm:dev:worker\"",
    "dev:site": "eleventy --config=eleventy.config.js --watch",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:pull:remote": "mkdir -p .tmp && wrangler d1 export film-crew --remote --output .tmp/remote-d1-export.sql --skip-confirmation",
    "db:pull:local": "rm -rf .wrangler/state/v3/d1 && wrangler d1 execute film-crew --local --file .tmp/remote-d1-export.sql --yes",
    "db:pull": "npm run db:pull:remote && npm run db:pull:local"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "concurrently": "^9.1.2",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "wrangler": "^4.15.0"
  }
}
